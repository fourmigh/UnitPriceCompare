<view class="page-wrap">
  <view class="scroll-area">
    <slot />
  </view>
  <view class="bottom-bar">
    <button wx:if="{{deleteVisible}}" class="bottom-btn delete-btn" disabled="{{deleteDisabled}}" loading="{{deleteLoading}}" bindtap="onDeleteTap">{{deleteText}}</button>
    <button class="bottom-btn primary-btn" disabled="{{barDisabled}}" loading="{{barLoading}}" bindtap="onBarTap">{{barText}}</button>
  </view>
</view>
